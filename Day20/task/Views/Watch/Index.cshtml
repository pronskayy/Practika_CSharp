@using WatchList.ViewModels
@{
    ViewData["Title"] = "Моя коллекция WatchList";
}

<h2>Коллекция фильмов и сериалов</h2>

<!-- Отображение уведомлений из TempData -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p>
    <a asp-action="Add" class="btn btn-primary">➕ Добавить фильм или сериал</a>
</p>

<hr />

<div class="row">
    <!-- План к просмотру -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5>⏳ Буду смотреть</h5>
            </div>
            <div class="card-body">
                @{
                    var planToWatch = ViewBag.PlanToWatch as List<WatchlistItemViewModel> ?? new List<WatchlistItemViewModel>();
                }
                @if (planToWatch.Any())
                {
                    <ul class="list-group">
                        @foreach (var item in planToWatch)
                        {
                            <li class="list-group-item">
                                <strong>@item.Title</strong><br />
                                <small> @item.Genre | @(item.Type == "Film" ? "🎬 Фильм" : "📺 Сериал")</small>
                                @if (item.Rating.HasValue)
                                {
                                    <span> | ⭐ @item.Rating/10</span>
                                }
                                <div class="mt-2">
                                    <a asp-action="MarkAsWatched" asp-route-id="@item.Id" class="btn btn-sm btn-success">✅ Смотрено</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Удалить?')">🗑 Удалить</a>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Список пуст</p>
                }
            </div>
        </div>
    </div>

    <!-- Смотрю сейчас -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-warning">
                <h5>📖 Смотрю сейчас</h5>
            </div>
            <div class="card-body">
                @{
                    var watching = ViewBag.Watching as List<WatchlistItemViewModel> ?? new List<WatchlistItemViewModel>();
                }
                @if (watching.Any())
                {
                    <ul class="list-group">
                        @foreach (var item in watching)
                        {
                            <li class="list-group-item">
                                <strong>@item.Title</strong><br />
                                <small> @item.Genre | @(item.Type == "Film" ? " Фильм" : " Сериал")</small>
                                @if (item.Rating.HasValue)
                                {
                                    <span> | ⭐ @item.Rating/10</span>
                                }
                                <div class="mt-2">
                                    <a asp-action="MarkAsWatched" asp-route-id="@item.Id" class="btn btn-sm btn-success">✅ Смотрено</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Удалить?')">🗑 Удалить</a>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Список пуст</p>
                }
            </div>
        </div>
    </div>

    <!-- Просмотрено -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5>✅ Просмотрено</h5>
            </div>
            <div class="card-body">
                @{
                    var watched = ViewBag.Watched as List<WatchlistItemViewModel> ?? new List<WatchlistItemViewModel>();
                }
                @if (watched.Any())
                {
                    <ul class="list-group">
                        @foreach (var item in watched)
                        {
                            <li class="list-group-item">
                                <strong>@item.Title</strong><br />
                                <small> @item.Genre | @(item.Type == "Film" ? " Фильм" : " Сериал")</small>
                                @if (item.Rating.HasValue)
                                {
                                    <span> | ⭐ @item.Rating/10</span>
                                }
                                <div class="mt-2">
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Удалить?')">🗑 Удалить</a>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Список пуст</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Подключение Bootstrap для стилей (необязательно, но для красоты) -->
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
}