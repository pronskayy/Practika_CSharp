<Window x:Class="EmployeeManagement.Views.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="700" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Добавление сотрудника" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Фамилия -->
                <TextBlock Text="Фамилия " Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Employee.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputField}"/>

                <!-- Имя -->
                <TextBlock Text="Имя " Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Employee.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputField}"/>

                <!-- Отчество -->
                <TextBlock Text="Отчество" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Employee.MiddleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputField}"/>

                <!-- Должность -->
                <TextBlock Text="Должность" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Positions}"
                          SelectedItem="{Binding Employee.Position, Mode=TwoWay}"
                          Height="36" FontSize="14"/>

                <!-- Отдел -->
                <TextBlock Text="Отдел" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Departments}"
                          SelectedItem="{Binding Employee.Department, Mode=TwoWay}"
                          Height="36" FontSize="14"/>

                <!-- Email -->
                <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Employee.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputField}"/>

                <!-- Телефон -->
                <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Employee.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputField}"/>

                <!-- Зарплата -->
                <TextBlock Text="Зарплата" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Employee.Salary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputField}"/>

                <!-- Дата найма -->
                <TextBlock Text="Дата найма" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding Employee.HireDate, Mode=TwoWay}"
                            Height="36" FontSize="14"/>

                <!-- GroupBox + RadioButton (статус присутствия) -->
                <GroupBox Header="Статус присутствия" Margin="0,10,0,0" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Доступен" Margin="0,0,20,0" FontSize="13"
                                     IsChecked="{Binding Employee.IsAvailable, Mode=TwoWay}"/>
                        <RadioButton Content="Отсутствует" FontSize="13"
                                     IsChecked="{Binding Employee.IsAvailable, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Отмена" Margin="0,0,10,0"
                    Style="{StaticResource ActionButton}"
                    Background="#EEE" BorderBrush="#CCC"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Сохранить"
                    Style="{StaticResource ActionButton}"
                    Background="#7C83FD" Foreground="White" BorderThickness="0"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>