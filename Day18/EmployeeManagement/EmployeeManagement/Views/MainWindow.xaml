<Window x:Class="EmployeeManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт сотрудников" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Window.Resources>

        <ControlTemplate x:Key="AddButtonTemplate" TargetType="Button">
            <Border x:Name="border" CornerRadius="10" Background="#7C83FD" Padding="16,10">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ContentPresenter VerticalAlignment="Center" TextBlock.Foreground="White" TextBlock.FontSize="13" TextBlock.FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="border"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#5C64F0" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="scale"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.05" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetName="scale"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.05" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="border"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#7C83FD" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="scale"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.0" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetName="scale"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- DataTemplate для карточки сотрудника (с анимацией раскрытия) -->
        <DataTemplate x:Key="EmployeeCardTemplate">
            <Border x:Name="CardBorder" CornerRadius="12" Background="White" Margin="6"
                BorderBrush="#E0E0E0" BorderThickness="2" Width="320" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>

                <Grid Margin="15,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Верхняя часть карточки (Краткая информация) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Аватар -->
                        <Border Width="46" Height="46" CornerRadius="23" Background="#7C83FD">
                            <TextBlock Text="{Binding FirstName[0]}" FontSize="20" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- ФИО и Должность -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FullName, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#333"/>
                            <TextBlock Text="{Binding Position, Mode=OneWay}" FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
                            <TextBlock FontSize="11" Foreground="#888" Margin="0,2,0,0">
                            <Run Text="{Binding Department, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Статус -->
                        <Border x:Name="StatusIcon" Grid.Column="2" Width="36" Height="36" CornerRadius="18"
                            Background="{Binding IsAvailable, Converter={StaticResource ColorConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="StatusIcon"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="1.0" To="1.15" Duration="0:0:1"/>
                                            <DoubleAnimation Storyboard.TargetName="StatusIcon"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="1.0" To="1.15" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>

                    <!-- Нижняя часть карточки (Раскрывающиеся детали) -->
                    <Border x:Name="DetailsSection" Grid.Row="1" Opacity="0" Margin="0,15,0,0">
                        <Border.LayoutTransform>
                            <ScaleTransform x:Name="DetailsScale" ScaleY="0"/>
                        </Border.LayoutTransform>
                        <StackPanel>
                            <Separator Margin="0,0,0,10" Background="#EEE"/>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📧" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding Email}" FontSize="12" Foreground="#555" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📱" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding Phone}" FontSize="12" Foreground="#555" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="💰" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding Salary, StringFormat={}{0:N0} Br}" FontSize="12" Foreground="#555" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📅" FontSize="12"/>
                                <TextBlock Grid.Column="1" FontSize="12" Foreground="#555" Margin="8,0,0,0">
                                <Run Text="Нанят: "/>
                                <Run Text="{Binding HireDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Анимация раскрытия и наведения -->
                <Border.Triggers>
                    <!-- Наведение мыши -->
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>

            <!-- Триггеры для привязки к выделению (IsSelected) -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Плавное раскрытие вниз -->
                                <DoubleAnimation Storyboard.TargetName="DetailsScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <!-- Плавное появление текста -->
                                <DoubleAnimation Storyboard.TargetName="DetailsSection" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" BeginTime="0:0:0.1"/>
                                <!-- Подсветка рамки при выделении -->
                                <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#7C83FD" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Плавное скрытие текста -->
                                <DoubleAnimation Storyboard.TargetName="DetailsSection" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                <!-- Плавное сворачивание вверх -->
                                <DoubleAnimation Storyboard.TargetName="DetailsScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <!-- Возврат цвета рамки -->
                                <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#E0E0E0" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#78DBE2">
            <Menu.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>
            </Menu.ItemContainerStyle>
            <MenuItem Header="Файл">
                <MenuItem Header="Сохранить" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
                <MenuItem Header="Обновить" InputGestureText="F5" Command="{Binding RefreshCommand}"/>
                <Separator/>
                <MenuItem Header="Выход" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Сотрудники">
                <MenuItem Header="Добавить сотрудника" InputGestureText="Ctrl+N" Command="{Binding AddCommand}"/>
                <MenuItem Header="Редактировать сотрудника" InputGestureText="Ctrl+E" Command="{Binding EditCommand}"/>
                <MenuItem Header="Удалить сотрудника" InputGestureText="Del" Command="{Binding DeleteCommand}"/>
            </MenuItem>
            <MenuItem Header="Отчёты">
                <MenuItem Header="По отделам" Click="MenuReportDept_Click"/>
                <MenuItem Header="Статистика зарплат" Click="MenuReportStat_Click"/>
                <MenuItem Header="По должностям" Click="MenuReportPosition_Click"/>
            </MenuItem>
            <MenuItem Header="Настройки">
                <MenuItem Header="Открыть чат" Click="MenuChat_Click"/>
                <MenuItem Header="Отправить уведомление" Click="MenuNotify_Click"/>
            </MenuItem>
            <MenuItem Header="Помощь">
                <MenuItem Header="О программе" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar Grid.Row="1" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Button Template="{StaticResource AddButtonTemplate}"
                    Content="Добавить сотрудника"
                    Command="{Binding AddCommand}"
                    Margin="4,4"
                    ToolTip="Добавить нового сотрудника (Ctrl+N)">
                <Button.RenderTransform>
                    <ScaleTransform CenterX="0.5" CenterY="0.5"/>
                </Button.RenderTransform>
            </Button>
            <Button Command="{Binding EditCommand}"
                    ToolTip="Редактировать выбранного (Ctrl+E)"
                    Margin="0,4,10,4" Padding="12,8" Cursor="Hand"
                    Background="#FFF3E0" BorderBrush="#FFB74D">
                <TextBlock Text="Редактировать" FontSize="13"/>
            </Button>
            <Button Command="{Binding DeleteCommand}"
                    ToolTip="Удалить выбранного (Del)"
                    Margin="0,4,10,4" Padding="12,8" Cursor="Hand"
                    Background="#FFEBEE" BorderBrush="#EF9A9A">
                <TextBlock Text="Удалить" FontSize="13"/>
            </Button>
            <Button Command="{Binding SaveCommand}"
                    ToolTip="Сохранить в файл (Ctrl+S)"
                    Margin="0,4,10,4" Padding="12,8" Cursor="Hand"
                    Background="#E8F5E9" BorderBrush="#A5D6A7">
                <TextBlock Text="Сохранить" FontSize="13"/>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="{Binding CurrentUser}" FontSize="13" FontWeight="Bold" Foreground="#555"/>
                <TextBlock Text=" (" FontSize="13" Foreground="#888"/>
                <TextBlock Text="{Binding CurrentUserRole}" FontSize="13" Foreground="#7C83FD"/>
                <TextBlock Text=")" FontSize="13" Foreground="#888"/>
            </StackPanel>
        </ToolBar>

        <Border Grid.Row="2" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="8" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1">
                    <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             FontSize="13" Height="36" Padding="10,0,10,0"
                             VerticalContentAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Отдел:" FontSize="13" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Departments}"
                              SelectedItem="{Binding FilterDepartment, Mode=TwoWay}"
                              Width="150" Height="36" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Должность:" FontSize="13" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Positions}"
                              SelectedItem="{Binding FilterPosition, Mode=TwoWay}"
                              Width="150" Height="36" FontSize="13"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#888">
                    <Run Text="Найдено: "/>
                    <Run Text="{Binding FilteredEmployees.Count, Mode=OneWay}" FontWeight="Bold" Foreground="#7C83FD"/>
                </TextBlock>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="3" Height="4"
                     Value="{Binding LoadingProgress}"
                     Maximum="100"
                     Foreground="#7C83FD"
                     Background="#E0E0E0"
                     BorderThickness="0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ====== ИЗМЕНЕНИЕ: Grid Row="4" — заменён на TabControl ====== -->
        <TabControl Grid.Row="4" Background="Transparent" BorderThickness="0">

            <!-- Вкладка 1: карточки — ваш существующий код без изменений -->
            <TabItem Header="Карточки">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding FilteredEmployees.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                        <TextBlock Text="Сотрудники не найдены" FontSize="16" Foreground="#AAA"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding FilteredEmployees}"
                             SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                             ItemTemplate="{StaticResource EmployeeCardTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="10"
                             SelectionChanged="ListBox_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.4"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="20" To="0" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: ListView — привязка Employees (задание) -->
            <TabItem Header="Таблица">
                <!-- ItemsSource="{Binding Employees}" — привязка из репозитория (задание) -->
                <ListView ItemsSource="{Binding Employees}"
                          SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                          Background="White" BorderBrush="#E0E0E0"
                          FontSize="13" Margin="10">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" Width="45"
                                            DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="ФИО" Width="210"
                                            DisplayMemberBinding="{Binding FullName, Mode=OneWay}"/>
                            <GridViewColumn Header="Должность" Width="130"
                                            DisplayMemberBinding="{Binding Position}"/>
                            <GridViewColumn Header="Отдел" Width="110"
                                            DisplayMemberBinding="{Binding Department}"/>
                            <GridViewColumn Header="Email" Width="170"
                                            DisplayMemberBinding="{Binding Email}"/>
                            <GridViewColumn Header="Телефон" Width="120"
                                            DisplayMemberBinding="{Binding Phone}"/>
                            <GridViewColumn Header="Зарплата" Width="100">
                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="Salary" StringFormat="{}{0:N0} Br"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                            <GridViewColumn Header="Дата найма" Width="100">
                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="HireDate" StringFormat="{}{0:dd.MM.yyyy}"/>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                            <GridViewColumn Header="Статус" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding IsAvailable, Converter={StaticResource StatusConverter}}"
                                            Foreground="{Binding IsAvailable, Converter={StaticResource ColorConverter}}"
                                            FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Height" Value="34"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E8EAFD"/>
                                    <Setter Property="Foreground" Value="#333"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F2FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </TabItem>

        </TabControl>

        <StatusBar Grid.Row="5" Background="#2D2D3F">
            <StatusBarItem>
                <TextBlock Foreground="#AAA" FontSize="12"
                           Text="Ctrl+N — Добавить | Ctrl+E — Изменить | Del — Удалить" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>