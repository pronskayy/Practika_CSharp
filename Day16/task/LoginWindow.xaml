<Window x:Class="Day15.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Day15.ViewModels"
        Title="Вход в систему" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid Background="#F0F2F5">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="319" Height="289">
            <TextBlock Text="Автоматизация учета сотрудников" FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <TextBlock Text="Логин" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Username}" Height="35" Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="Пароль" Margin="0,0,0,5"/>
            <PasswordBox x:Name="pbPassword" Height="35" Margin="0,0,0,20" Padding="5"/>

            <Button Content="Войти" Command="{Binding LoginCommand}" Height="40" 
                    Background="#4CAF50" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
            <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}" Height="35" 
                    Background="#2196F3" Foreground="White" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>