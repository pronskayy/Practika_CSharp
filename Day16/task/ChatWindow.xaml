<Window x:Class="Day15.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат отдела" Height="450" Width="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="txtMessage" TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto" Margin="0,10,0,26"/>

        <Button Grid.Row="2" Content="Отправить" Height="35" Background="#4CAF50" 
                Foreground="White" Click="SendMessage_Click"/>
    </Grid>
</Window>