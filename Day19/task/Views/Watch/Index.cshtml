@model List<WatchList.Models.WatchItem>

<h2>Мой список просмотра</h2>

<a href="/Watch/Add">Добавить фильм/сериал</a>

<h3>Не просмотрено</h3>
<table border="1">
    <tr>
        <th>Название</th>
        <th>Тип</th>
        <th>Действие</th>
    </tr>
    @foreach (var item in Model.Where(x => x.Status == "Не просмотрено"))
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Type</td>
            <td><a href="/Watch/MarkAsWatched/@item.Id">Отметить просмотренным</a></td>
        </tr>
    }
</table>

<h3>Просмотрено</h3>
<table border="1">
    <tr>
        <th>Название</th>
        <th>Тип</th>
        <th>Статус</th>
    </tr>
    @foreach (var item in Model.Where(x => x.Status == "Просмотрено"))
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Type</td>
            <td>✅ Просмотрено</td>
        </tr>
    }
</table>