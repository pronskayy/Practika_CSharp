<Window x:Class="Day15.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Day15.ViewModels"
        Title="Автоматизация учета сотрудников" 
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DeleteCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5"/>
        </Storyboard>

        <Storyboard x:Key="StatusPulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                         From="0.8" To="1.2" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                         From="0.8" To="1.2" Duration="0:0:0.5"/>
        </Storyboard>

        <Storyboard x:Key="ExpandProfileAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Height"
                         From="0" To="120" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="CollapseProfileAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Height"
                         From="120" To="0" Duration="0:0:0.3"/>
        </Storyboard>
        <ControlTemplate x:Key="AddButtonTemplate" TargetType="Button">
            <Border Background="#4CAF50" CornerRadius="8" Padding="12,6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <!-- DataTemplate для карточки сотрудника (с анимацией) -->
        <DataTemplate x:Key="EmployeeCardTemplate">
            <Border BorderBrush="#DDD" BorderThickness="1" Margin="5" Padding="12" CornerRadius="8" 
                    Background="White" Opacity="0" Loaded="EmployeeCard_Loaded">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Индикатор статуса с анимацией -->
                    <Ellipse x:Name="StatusIndicator" Grid.Column="0" 
                             Width="12" Height="12" Margin="0,0,10,0"
                             VerticalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <ScaleTransform CenterX="6" CenterY="6"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Информация о сотруднике -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding Position}" Foreground="Gray" FontSize="12"/>
                    </StackPanel>

                    <!-- Кнопка раскрытия профиля -->
                    <Button Grid.Column="2" Content="▼" Width="30" Height="30" 
                            Tag="{Binding}" Click="ToggleProfile_Click"
                            Background="Transparent" BorderThickness="0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Сотрудники">
                <MenuItem Header="Добавить" Command="{Binding AddCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Редактировать" Command="{Binding EditCommand}" InputGestureText="Ctrl+E"/>
                <Separator/>
                <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" InputGestureText="Ctrl+D"/>
            </MenuItem>
            <MenuItem Header="Отчёты">
                <MenuItem Header="Все сотрудники" Click="ReportAll_Click"/>
            </MenuItem>
            <MenuItem Header="Настройки">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Command="{Binding AddCommand}" ToolTip="Добавить (Ctrl+N)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Добавить"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding EditCommand}" ToolTip="Редактировать (Ctrl+E)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Редактировать"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding DeleteCommand}" ToolTip="Удалить (Ctrl+D)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Удалить"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding OpenChatCommand}" ToolTip="Чат отдела">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Чат"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SendNotificationCommand}" ToolTip="Отправить уведомление">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Уведомить"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar Grid.Row="0" Height="8" Margin="0,0,0,10"
                         IsIndeterminate="{Binding IsLoading}"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Отдел:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                <ComboBox Width="150" ItemsSource="{Binding Departments}" DisplayMemberPath="Name" 
                          SelectedValuePath="Id" SelectedValue="{Binding SelectedDepartmentId}"/>

                <TextBlock Text="Должность:" VerticalAlignment="Center" Margin="20,0,10,0" FontWeight="Bold"/>
                <ComboBox x:Name="cbPosition" Width="120" SelectionChanged="CbPosition_SelectionChanged">
                    <ComboBoxItem Content="Все" IsSelected="True"/>
                    <ComboBoxItem Content="Разработчик"/>
                    <ComboBoxItem Content="Менеджер"/>
                    <ComboBoxItem Content="Аналитик"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Список сотрудников" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

            <ListBox Grid.Row="3" x:Name="lbEmployees" 
                     ItemsSource="{Binding Employees}"
                     SelectedItem="{Binding SelectedEmployee}"
                     ItemTemplate="{StaticResource EmployeeCardTemplate}"
                     Height="250" Margin="0,0,0,10"/>

            <GroupBox Grid.Row="4" Header="Редактирование сотрудника" Margin="0,5,0,0">
                <StackPanel Margin="10">
                    <TextBlock Text="ФИО:" FontWeight="Bold"/>
                    <TextBox Text="{Binding SelectedEmployee.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,5,0,10" Height="30"/>

                    <TextBlock Text="Должность:" FontWeight="Bold"/>
                    <TextBox Text="{Binding SelectedEmployee.Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,5,0,10" Height="30"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Template="{StaticResource AddButtonTemplate}" Content="Добавить" 
                                Command="{Binding AddCommand}" Margin="5" Width="100" Height="35"/>
                        <Button Content="Редактировать" Command="{Binding EditCommand}" Margin="5" 
                                Width="100" Height="35" Background="#2196F3" Foreground="White"/>
                        <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="5" 
                                Width="100" Height="35" Background="#F44336" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Раскрывающийся профиль сотрудника -->
            <Border x:Name="ExpandedProfile" Grid.Row="5" 
                    Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,10,0,0"
                    Height="0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ProfileName" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ProfilePosition" Foreground="Gray" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ProfileDepartment" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ProfileStatus" Margin="0,0,0,10"/>
                    <Button Content="Закрыть" Click="CloseProfile_Click" Width="80" 
                            Background="#FF5722" Foreground="White" Padding="5"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" 
                    CornerRadius="5" Padding="10" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Последние уведомления" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ListBox ItemsSource="{Binding Notifications}" Height="60"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>