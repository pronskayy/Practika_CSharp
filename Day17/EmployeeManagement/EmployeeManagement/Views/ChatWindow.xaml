<Window x:Class="EmployeeManagement.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат между отделами" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" ItemsSource="{Binding Messages}"
                 Background="#2D2D3F" BorderBrush="#444"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 x:Name="MessageList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#3D3D5F" CornerRadius="8" Margin="4" Padding="10,6">
                        <TextBlock Text="{Binding FormattedMessage}" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                     Background="#2D2D3F" Foreground="White" BorderBrush="#5C5C8A"
                     Height="40" FontSize="14" Padding="10,0" VerticalContentAlignment="Center"
                     CaretBrush="White" Margin="0,0,10,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1" Content="Отправить" Command="{Binding SendCommand}"
                    Background="#7C83FD" Foreground="White" BorderThickness="0"
                    Height="40" Padding="15,0" FontSize="13" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>