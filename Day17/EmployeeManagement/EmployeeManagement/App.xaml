<Application x:Class="EmployeeManagement.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EmployeeManagement.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Все конвертеры регистрируем глобально -->
            <conv:BoolToStatusConverter x:Key="StatusConverter"/>
            <conv:BoolToColorConverter x:Key="ColorConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
            <conv:StatusIconConverter x:Key="StatusIconConverter"/>
        </ResourceDictionary>
    </Application.Resources>

</Application>